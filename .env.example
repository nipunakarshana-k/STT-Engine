# STT Engine Environment Variables

# JWT Secret for signing session cookies
JWT_SECRET=stt_engine_super_secret_session_key_12984710

# Google Gemini API Key for enabling live AI transcription, translation, summary, and chat.
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Python FastAPI backend service URL (default: http://127.0.0.1:8000)
FASTAPI_URL=http://127.0.0.1:8000
